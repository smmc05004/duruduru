{
  "name": "duruduru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:file": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "setup:e2e": "playwright install chromium",
    "verify": "npm run check:agent-harness && npm run lint && npm run typecheck && npm run test && npm run build",
    "cycle": "node scripts/work-cycle.mjs",
    "check:agent-harness": "node scripts/check-agent-harness.mjs",
    "check:tour-api": "node --env-file-if-exists=.env.local scripts/probe-tourapi.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
