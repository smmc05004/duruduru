# data.go.kr에서 발급한 한국관광공사_국문 관광정보 서비스_GW의 Decoding 서비스키
# 스크립트가 URL 인코딩을 처리하므로 Encoding 키를 넣으면 안 됩니다.
TOUR_API_SERVICE_KEY=

# data.go.kr에서 발급한 한국관광공사_기초지자체 중심 관광지 정보의 Decoding 서비스키
# (https://www.data.go.kr/data/15128559/openapi.do). `npm run build:central-attractions`가
# LocgoHubTarService1/areaBasedList1을 서버에서만 호출할 때 씁니다. 스크립트가 URL 인코딩을
# 한 번만 처리하므로 Encoding 키를 넣으면 안 됩니다. 키·키 포함 URL은 로그·JSON에 남기지 않습니다.
CENTRAL_ATTRACTION_API_SERVICE_KEY=

# (선택) 중심 관광지 실행별 요청 예산. 미설정 시 400. 개발 계정 일일 한도(1,000)와 다릅니다.
# CENTRAL_ATTRACTION_MAX_REQUESTS=400

# data.go.kr에서 발급한 행정안전부 모범음식점정보 조회서비스의 Decoding 서비스키
# 서버 전용으로 사용하며 브라우저에 노출하지 않습니다.
EXCELLENT_RESTAURANT_API_SERVICE_KEY=
